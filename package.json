{
  "name": "betterclss",
  "version": "1.0.0",
  "private": true,
  "description": "BetterCLSS backend with Express + Firebase Cloud Messaging",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/check.js",
