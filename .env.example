[TEMPLATE]
CANVAS_DOMAIN=usc.instructure.com
# Optional fallback token for admin/single-user mode only.
CANVAS_TOKEN=

# Optional frontend override if static site points to separate backend.
# Browser users can also set this in the Connect Canvas modal.
# BCLSS_API_BASE_URL=https://your-backend.example.com

PORT=5500
MAX_OVERDUE_DAYS=30

# NOTE: AI is bring-your-own-key (BYOK). Users paste their own Gemini or Groq
# API keys in the app Settings; keys are sent per request and never stored on
# the server. No server-side AI provider keys are used.

# CORS for static frontend -> backend API requests
# Use * or set your GitHub Pages origin, e.g. https://markstock-it.github.io
CORS_ALLOW_ORIGIN=*

# Required to call POST /api/send-notification. Use a long random secret.
NOTIFICATION_ADMIN_KEY=

# Gemini / Groq model settings (keys are BYOK, sent per request by users)
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_TEMPERATURE=0.4

AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY_MS=1000
AI_LOG_REQUESTS=0

# Agentic Helper (experimental feature)
# Global kill switch for the Agentic Helper feature (0/1)
AGENT_ENABLED=1
# Max file size in MB for generated artifacts
AGENT_MAX_FILE_SIZE_MB=10
# Max concurrent agent jobs per user
AGENT_MAX_CONCURRENT_JOBS=3
# Max retries on agent failure
AGENT_MAX_RETRY_COUNT=2
# Auto-cleanup of old agent artifacts (days)
AGENT_FILE_RETENTION_DAYS=30
